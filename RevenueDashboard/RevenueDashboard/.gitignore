# ============================================================
# ป้องกันไม่ให้ข้อมูลบริษัทที่เป็นความลับหลุดขึ้น GitHub โดยไม่ตั้งใจ
# ============================================================

# ไฟล์ข้อมูลจริงทั้งหมด (.xlsx) ห้าม commit ขึ้น repo โดยเด็ดขาด
data/*.xlsx
data/*.xls
data/*.csv

# อนุญาตเฉพาะไฟล์ตัวอย่างที่ทำ anonymize/สุ่มแล้ว และอยู่ในโฟลเดอร์ sample_data/ เท่านั้น
!sample_data/**

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Streamlit
.streamlit/secrets.toml

# OS
.DS_Store
Thumbs.db

# Output/exports ที่อาจมีข้อมูลจริงติดไปด้วย
output/*.csv
output/*.xlsx

# ตารางแมปรหัสลูกหนี้ตัวเต็ม (584,941 แถว, 32 MB) ไม่เอาขึ้น repo สาธารณะ
# เป็นไฟล์เดียวกับที่ root gitignore ไว้แล้ว ถ้าต้องใช้ให้ก็อปมาวางเอง
sample_data/แปลงรหัสลูกหนี้รวม.xlsx
